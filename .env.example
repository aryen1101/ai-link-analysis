# Copy to .env and fill in. Never commit .env.
# At least one LLM key is required. Providers are tried in LLM_PROVIDERS order; missing keys are skipped.

# OpenAI (primary) - https://platform.openai.com/api-keys
OPENAI_API_KEY=your-openai-key-here
OPENAI_MODEL=gpt-6-luna

# Google Gemini (fallback) - https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-key-here
GEMINI_MODEL=gemini-2.5-flash-lite

# Groq (fallback) - https://console.groq.com/keys
GROQ_API_KEY=your-groq-key-here
GROQ_MODEL=openai/gpt-oss-120b

LLM_PROVIDERS=openai,gemini,groq
LLM_TIMEOUT_SECONDS=90

# Web research for social profiles / blocked pages (search tools with cited sources)
WEB_RESEARCH_ENABLED=true
RESEARCH_PROVIDERS=openai,groq

FETCH_TIMEOUT_SECONDS=15
MAX_EXTRA_PAGES=3

CACHE_TTL_SECONDS=3600
LOG_LEVEL=INFO
