# Error-handling cases against a local server (uvicorn app.main:app --port 4000)

$ curl -X POST localhost:4000/link-analysis -d '{"url":"http://127.0.0.1:8000/admin"}'
{"success":false,"website":"http://127.0.0.1:8000/admin","error":{"code":"blocked_url","message":"Only default web ports (80/443) are allowed."}}
HTTP 400

$ curl -X POST localhost:4000/link-analysis -d '{"url":"http://169.254.169.254/latest/meta-data"}'
{"success":false,"website":"http://169.254.169.254/latest/meta-data","error":{"code":"blocked_url","message":"Access to private or internal IP addresses is not allowed."}}
HTTP 400

$ curl -X POST localhost:4000/link-analysis -d '{"url":"http://localhost/"}'
{"success":false,"website":"http://localhost/","error":{"code":"blocked_url","message":"Access to local or internal hostnames is not allowed."}}
HTTP 400

$ curl -X POST localhost:4000/link-analysis -d '{"url":"ftp://example.com"}'
{"success":false,"website":"ftp://example.com","error":{"code":"invalid_url","message":"Only http and https URLs are supported."}}
HTTP 400

$ curl -X POST localhost:4000/link-analysis -d '{"url":"not a url"}'
{"success":false,"website":"not a url","error":{"code":"invalid_url","message":"URL must not contain whitespace."}}
HTTP 400

$ curl -X POST localhost:4000/link-analysis -d '{"url":"https://thisdomaindoesnotexist-xyz123.com"}'
{"success":false,"website":"https://thisdomaindoesnotexist-xyz123.com","error":{"code":"invalid_url","message":"Domain 'thisdomaindoesnotexist-xyz123.com' could not be resolved."}}
HTTP 400

$ curl -X POST localhost:4000/link-analysis -d '{}'
{"success":false,"website":null,"error":{"code":"invalid_request","message":"body.url: Field required"}}
HTTP 422

